{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es2022",
        "outDir": "out",
        "lib": [
            "es2022"
        ],
        "sourceMap": true,
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitReturns": true,
        "forceConsistentCasingInFileNames": true,
        "esModuleInterop": true,
        "paths": {
            "aw-client": ["./aw-client-js/src/aw-client.ts"]
        }
    },
    "include": [
        "src/**/*.ts",
        "aw-client-js/src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        ".vscode-test"
    ]
}
{
    "name": "aw-watcher-vscode",
    "displayName": "aw-watcher-vscode",
    "description": "Editor watcher for ActivityWatch, the free and open-source automated time tracker.",
    "version": "0.6.0",
    "repository": {
        "type": "git",
        "url": "https://github.com/ActivityWatch/aw-watcher-vscode"
    },
    "publisher": "activitywatch",
    "author": "ActivityWatch Developers",
    "bugs": {
        "url": "https://github.com/ActivityWatch/aw-watcher-vscode/issues"
    },
    "engines": {
        "vscode": "^1.85.0",
        "node": ">=18"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "multi-root ready"
    ],
    "icon": "media/logo/logo.png",
    "activationEvents": [
        "onStartupFinished"
    ],
    "extensionKind": [
        "ui"
    ],
    "main": "./out/src/extension",
    "contributes": {
        "commands": [
            {
                "command": "extension.reload",
                "title": "Reload ActivityWatch"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "aw-watcher-vscode extension configuration",
            "properties": {
                "aw-watcher-vscode.maxHeartbeatsPerSec": {
                    "type": "number",
                    "default": 1,
                    "exclusiveMinimum": 0,
                    "description": "Maximum number of heartbeats sent per second while editing the same file. Fractional values are allowed, e.g. 0.5 sends at most one heartbeat every 2 seconds."
                },
                "aw-watcher-vscode.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable or disable the ActivityWatch editor watcher."
                },
                "aw-watcher-vscode.serverUrl": {
                    "type": "string",
                    "default": "",
                    "description": "Optional ActivityWatch server URL. Leave empty to use the default (http://127.0.0.1:5600).",
                    "examples": ["http://127.0.0.1:5600"]
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext .ts",
        "format:check": "prettier --check \"src/**/*.ts\"",
        "vscode:prepublish": "npm run compile",
        "test": "npm run compile && vscode-test",
        "test:mocha": "npm run compile && node ./node_modules/mocha/bin/mocha \"./out/src/test/*.test.js\"",
        "package": "vsce package --no-dependencies"
    },
    "devDependencies": {
        "@types/mocha": "^10.0.0",
        "@types/node": "^22.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "eslint": "^8.57.0",
        "mocha": "^10.7.0",
        "prettier": "^3.3.0",
        "typescript": "^5.6.0",
        "vscode": "^1.1.37",
        "@vscode/test-cli": "^0.0.9",
        "@vscode/test-electron": "^2.4.0",
        "@vscode/vsce": "^2.0.0"
    }
}
